<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>McpDotnetServer</RootNamespace>
    <!-- ReadyToRun: pre-compiled but still requires the .NET runtime -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.1.26104.118" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />
  </ItemGroup>

  <!-- Reuse source files from the AOT server project -->
  <ItemGroup>
    <Compile Include="..\dotnet-aot-server\BenchmarkTools.cs" Link="BenchmarkTools.cs" />
  </ItemGroup>

</Project>

